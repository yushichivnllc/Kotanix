#!/bin/sh
# Kotanix launcher — paths are resolved relative to $APPDIR at runtime.
# Falls back to the script's own location when APPDIR is unset (e.g. running from a plain AppDir).
APPDIR="${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}"
export LANG="${LANG:-C.UTF-8}"
exec "$APPDIR/usr/lib/kotanix/jre/bin/java" \
	-Djava.library.path="$APPDIR/usr/lib/kotanix/lib" \
	-cp "$APPDIR/usr/lib/kotanix/lib/*" \
	kotanix.ui.KotanixKt "$@"
